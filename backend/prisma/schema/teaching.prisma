/// Which courses a programme's students take at each level and semester.
model ProgrammeCourse {
  programmeId String    @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  courseId    String    @db.Uuid
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level       Int
  semesterNo  Int
  isElective  Boolean   @default(false)

  @@id([programmeId, courseId])
  @@index([programmeId, level, semesterNo])
}

/// A course running in a particular semester.
model CourseOffering {
  id         String               @id @default(uuid()) @db.Uuid
  courseId   String               @db.Uuid
  course     Course               @relation(fields: [courseId], references: [id])
  semesterId String               @db.Uuid
  semester   Semester             @relation(fields: [semesterId], references: [id])
  /// Optional seat limit. Null means no limit.
  capacity   Int?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  lecturers   OfferingLecturer[]
  items       CourseRegistrationItem[]
  assessments   Assessment[]
  resultSheet   ResultSheet?
  examSession   ExamSession?
  examHolds     ExamHold[]
  eligibilities ExamEligibility[]
  classSessions ClassSession[]

  @@unique([courseId, semesterId])
  @@index([semesterId])
}

model OfferingLecturer {
  offeringId String         @db.Uuid
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id])
  /// The lecturer responsible for the course. Exactly one per offering when any are assigned.
  isLead     Boolean        @default(false)
  assignedAt DateTime       @default(now())

  @@id([offeringId, userId])
  @@index([userId])
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// A student's course registration for one semester.
model CourseRegistration {
  id           String                   @id @default(uuid()) @db.Uuid
  studentId    String                   @db.Uuid
  student      User                     @relation("RegistrationStudent", fields: [studentId], references: [id])
  semesterId   String                   @db.Uuid
  semester     Semester                 @relation(fields: [semesterId], references: [id])
  status       RegistrationStatus       @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?                  @db.Uuid
  reviewedBy   User?                    @relation("RegistrationReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  /// An approved registration reopened for changes: by whom, when and why.
  /// The curriculum stage the student registered as their main semester (for example 5).
  mainStage    Int?
  reopenedAt   DateTime?
  reopenedById String?  @db.Uuid
  reopenReason String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  items        CourseRegistrationItem[]

  @@unique([studentId, semesterId])
  @@index([semesterId, status])
}

model CourseRegistrationItem {
  registrationId String             @db.Uuid
  registration   CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  offeringId     String             @db.Uuid
  offering       CourseOffering     @relation(fields: [offeringId], references: [id])

  @@id([registrationId, offeringId])
  @@index([offeringId])
}

/// A student's own academic advisor, assigned by the Head of Department or the Registry. Advisors with
/// advisees review only them; students without one are reviewed by any advisor in the department.
model AdvisorAssignment {
  studentId    String   @id @db.Uuid
  student      User     @relation("Advisee", fields: [studentId], references: [id])
  advisorId    String   @db.Uuid
  advisor      User     @relation("Advisor", fields: [advisorId], references: [id])
  assignedById String   @db.Uuid
  createdAt    DateTime @default(now())

  @@index([advisorId])
}
