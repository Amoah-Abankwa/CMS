/// A book or other item in the catalogue. Physical copies are LibraryCopy rows.
model LibraryTitle {
  id           String               @id @default(uuid()) @db.Uuid
  title        String
  subtitle     String?
  authors      String[]
  isbn         String?              @unique
  publisher    String?
  year         Int?
  edition      String?
  callNumber   String?
  subjects     String[]
  description  String?
  /// Lower-case title, authors, ISBN, call number and subjects, for partial-match search.
  searchText   String               @default("")
  /// E-book on a licensed platform the university subscribes to.
  ebookUrl     String?
  /// A PDF the library has the right to share, stored privately in Cloudinary.
  ebookDocumentId String?           @db.Uuid
  ebookDocument   StoredDocument?   @relation(fields: [ebookDocumentId], references: [id])
  ebookOpens   Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  copies       LibraryCopy[]
  reservations LibraryReservation[]
  readingItems ReadingListItem[]

  @@index([title])
}

enum CopyStatus {
  AVAILABLE
  ON_LOAN
  ON_HOLD
  LOST
  DAMAGED
  WITHDRAWN
}

model LibraryCopy {
  id          String               @id @default(uuid()) @db.Uuid
  titleId     String               @db.Uuid
  title       LibraryTitle         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  /// The accession number printed on the barcode label.
  barcode     String               @unique
  shelf       String?
  /// Reference copies stay in the library.
  isReference Boolean              @default(false)
  status      CopyStatus           @default(AVAILABLE)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  loans       Loan[]
  holds       LibraryReservation[]

  @@index([titleId, status])
}

enum LoanStatus {
  ACTIVE
  RETURNED
  LOST
}

model Loan {
  id                 String       @id @default(uuid()) @db.Uuid
  copyId             String       @db.Uuid
  copy               LibraryCopy  @relation(fields: [copyId], references: [id])
  borrowerId         String       @db.Uuid
  borrower           User         @relation("LoanBorrower", fields: [borrowerId], references: [id])
  issuedAt           DateTime     @default(now())
  dueAt              DateTime
  returnedAt         DateTime?
  renewals           Int          @default(0)
  status             LoanStatus   @default(ACTIVE)
  issuedById         String?      @db.Uuid
  returnedById       String?      @db.Uuid
  dueReminderSentAt  DateTime?
  overdueNoticeCount Int          @default(0)
  lastOverdueNoticeAt DateTime?
  fines              LibraryFine[]

  @@index([borrowerId, status])
  @@index([status, dueAt])
}

enum ReservationStatus {
  WAITING
  READY
  COLLECTED
  CANCELLED
  EXPIRED
}

/// A place in the queue for a title. When READY, a copy is kept for the borrower until expiresAt.
model LibraryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  titleId     String            @db.Uuid
  title       LibraryTitle      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  borrowerId  String            @db.Uuid
  borrower    User              @relation("ReservationBorrower", fields: [borrowerId], references: [id])
  status      ReservationStatus @default(WAITING)
  copyId      String?           @db.Uuid
  copy        LibraryCopy?      @relation(fields: [copyId], references: [id])
  readyAt     DateTime?
  expiresAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime          @default(now())

  @@index([titleId, status, createdAt])
  @@index([borrowerId, status])
}

enum FineReason {
  OVERDUE
  LOST
  DAMAGED
}

/// Amounts in pesewas. Outstanding = amount - paid - waived.
model LibraryFine {
  id         String        @id @default(uuid()) @db.Uuid
  borrowerId String        @db.Uuid
  borrower   User          @relation("FineBorrower", fields: [borrowerId], references: [id])
  loanId     String?       @db.Uuid
  loan       Loan?         @relation(fields: [loanId], references: [id])
  reason     FineReason
  amount     Int
  paid       Int           @default(0)
  waived     Int           @default(0)
  note       String?
  createdAt  DateTime      @default(now())
  settledAt  DateTime?
  payments   FinePayment[]

  @@index([borrowerId, settledAt])
}

enum FinePaymentMethod {
  CASH
  MOBILE_MONEY
  WAIVER
  ONLINE
}

model FinePayment {
  id            String            @id @default(uuid()) @db.Uuid
  fineId        String            @db.Uuid
  fine          LibraryFine       @relation(fields: [fineId], references: [id], onDelete: Cascade)
  amount        Int
  method        FinePaymentMethod
  receiptNumber String?
  /// Paystack reference for online payments; unique so a payment is applied once.
  reference     String?           @unique
  note          String?
  recordedById  String            @db.Uuid
  createdAt     DateTime          @default(now())
}

/// A graduation clearance certificate, issued by the Librarian when the student has nothing out and owes nothing.
model LibraryClearance {
  id                String    @id @default(uuid()) @db.Uuid
  studentId         String    @db.Uuid
  student           User      @relation("LibraryClearanceStudent", fields: [studentId], references: [id])
  certificateNumber String    @unique
  clearedById       String    @db.Uuid
  note              String?
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  revokeReason      String?

  @@index([studentId])
}

enum IllStatus {
  REQUESTED
  ORDERED
  ARRIVED
  ON_LOAN
  RETURNED
  REJECTED
  CANCELLED
}

/// A book borrowed from another library for a member.
model InterLibraryLoan {
  id             String    @id @default(uuid()) @db.Uuid
  requesterId    String    @db.Uuid
  requester      User      @relation("IllRequester", fields: [requesterId], references: [id])
  title          String
  authors        String?
  isbn           String?
  lendingLibrary String?
  neededBy       DateTime? @db.Date
  note           String?
  status         IllStatus @default(REQUESTED)
  dueDate        DateTime? @db.Date
  librarianNote  String?
  updatedById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([requesterId])
}

/// A course's reading list, kept per course so it carries over from semester to semester.
model ReadingList {
  id          String            @id @default(uuid()) @db.Uuid
  courseId    String            @unique @db.Uuid
  course      Course            @relation(fields: [courseId], references: [id])
  updatedById String            @db.Uuid
  updatedAt   DateTime          @updatedAt
  items       ReadingListItem[]
}

enum ReadingImportance {
  ESSENTIAL
  RECOMMENDED
}

model ReadingListItem {
  id         String            @id @default(uuid()) @db.Uuid
  listId     String            @db.Uuid
  list       ReadingList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// A book in the catalogue, or else a free citation (article, chapter, website).
  titleId    String?           @db.Uuid
  title      LibraryTitle?     @relation(fields: [titleId], references: [id])
  citation   String?
  url        String?
  importance ReadingImportance @default(RECOMMENDED)
  note       String?
  position   Int               @default(0)
}
