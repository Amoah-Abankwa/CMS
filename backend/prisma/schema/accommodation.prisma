enum HostelKind {
  UNIVERSITY
  PRIVATE
}

enum HostelGender {
  MALE
  FEMALE
  MIXED
}

enum HostelVerification {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// University hostels are single-gender. Private hostels may be mixed and need verifying before students see them.
model Hostel {
  id               String             @id @default(uuid()) @db.Uuid
  kind             HostelKind
  name             String             @unique
  /// Cloudinary public ids of photos (private hostels), first is the cover.
  photoIds      String[]           @default([])
  gender           HostelGender
  location         String?
  digitalAddress   String?
  distanceNote     String?
  description      String?
  facilities       String[]
  contactPhone     String?
  isActive         Boolean            @default(true)
  ownerId          String?            @db.Uuid
  owner            User?              @relation("HostelOwner", fields: [ownerId], references: [id])
  verification     HostelVerification @default(APPROVED)
  verificationNote String?
  verifiedAt       DateTime?
  verifiedById     String?            @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  rooms            Room[]
  roomTypes        PrivateRoomType[]
  /// Private hostels: where Finance sends online fees (mobile money), set by the owner.
  payoutNetwork    String?
  payoutNumber     String?
  payoutName       String?
  hostelFees       HostelFee[]
  ownerPayouts     HostelOwnerPayout[]
  formTemplates    HostelFormTemplate[]
  complaints       HostelComplaint[]
}

/// A room in a university hostel. Price per semester in pesewas.
model Room {
  id               String           @id @default(uuid()) @db.Uuid
  hostelId         String           @db.Uuid
  hostel           Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  number           String
  floor            String?
  capacity         Int
  roomType         String
  pricePerSemester Int
  isActive         Boolean          @default(true)
  notes            String?
  allocations      RoomAllocation[]

  @@unique([hostelId, number])
}

/// The application window and acceptance period for a semester.
model AccommodationRound {
  semesterId     String    @id @db.Uuid
  semester       Semester  @relation(fields: [semesterId], references: [id])
  opensAt        DateTime
  closesAt       DateTime
  acceptanceDays Int       @default(5)
  lastRunAt      DateTime?
  lastPublishedAt DateTime?
}

enum HostelApplicationStatus {
  SUBMITTED
  WITHDRAWN
  ALLOCATED
  UNPLACED
}

model HostelApplication {
  id                   String                  @id @default(uuid()) @db.Uuid
  semesterId           String                  @db.Uuid
  studentId            String                  @db.Uuid
  student              User                    @relation("HostelApplicant", fields: [studentId], references: [id])
  /// [{ hostelId, roomType | null }] in order of preference, up to 3.
  preferences          Json
  acceptAny            Boolean                 @default(false)
  /// Index number of the student they want to share a room with; honoured only if that student names them too.
  roommateIndex        String?
  /// The student's own description of a medical or disability need. Only the Hostel Office sees it.
  specialNeeds         String?
  specialNeedsApproved Boolean                 @default(false)
  status               HostelApplicationStatus @default(SUBMITTED)
  submittedAt          DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([semesterId, studentId])
  @@index([semesterId, status])
}

enum AllocationStatus {
  PROVISIONAL
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum AllocationSource {
  AUTO
  MANUAL
}

/// A bed for a student in a semester. PROVISIONAL, OFFERED and ACCEPTED hold the bed.
model RoomAllocation {
  id              String           @id @default(uuid()) @db.Uuid
  semesterId      String           @db.Uuid
  studentId       String           @db.Uuid
  student         User             @relation("RoomAllocationStudent", fields: [studentId], references: [id])
  roomId          String           @db.Uuid
  room            Room             @relation(fields: [roomId], references: [id])
  status          AllocationStatus
  source          AllocationSource
  preferenceRank  Int?
  offeredAt       DateTime?
  acceptBy        DateTime?
  respondedAt     DateTime?
  cancelReason    String?
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  /// Check-in and check-out at the hostel, recorded by the Hostel Manager (halls) or the owner (private).
  checkedInAt    DateTime?
  checkedInById  String?   @db.Uuid
  checkInNote    String?
  checkedOutAt   DateTime?
  checkedOutById String?   @db.Uuid
  checkOutNote   String?
  @@index([roomId, status])
  @@index([semesterId, studentId])
  @@index([status, acceptBy])
}

/// A kind of room a private hostel offers, e.g. "2 in a room, self-contained". Price per semester in pesewas.
model PrivateRoomType {
  id               String           @id @default(uuid()) @db.Uuid
  hostelId         String           @db.Uuid
  hostel           Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  name             String
  bedsPerRoom      Int
  pricePerSemester Int
  availableBeds    Int
  description      String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  bookings         PrivateBooking[]
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
}

model PrivateBooking {
  id          String          @id @default(uuid()) @db.Uuid
  semesterId  String          @db.Uuid
  studentId   String          @db.Uuid
  student     User            @relation("PrivateBookingStudent", fields: [studentId], references: [id])
  roomTypeId  String          @db.Uuid
  roomType    PrivateRoomType @relation(fields: [roomTypeId], references: [id])
  status      BookingStatus   @default(REQUESTED)
  message     String?
  ownerNote   String?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  /// Check-in and check-out at the hostel, recorded by the Hostel Manager (halls) or the owner (private).
  checkedInAt    DateTime?
  checkedInById  String?   @db.Uuid
  checkInNote    String?
  checkedOutAt   DateTime?
  checkedOutById String?   @db.Uuid
  checkOutNote   String?
  @@index([roomTypeId, status])
  @@index([semesterId, studentId])
}

/// A student living off campus (family, rented room) tells the university where.
model ResidenceDeclaration {
  studentId      String   @db.Uuid
  student        User     @relation("ResidenceStudent", fields: [studentId], references: [id])
  semesterId     String   @db.Uuid
  address        String
  digitalAddress String?
  landmark       String?
  updatedAt      DateTime @updatedAt

  @@id([studentId, semesterId])
}

/// What a student owes for their place this semester: a university room (price once accepted) or a
/// private hostel bed (price once the owner accepts). Paid online or recorded in cash by the Hostel
/// Manager or owner, each payment with a receipt.
model HostelFee {
  id           String             @id @default(uuid()) @db.Uuid
  studentId    String             @db.Uuid
  student      User               @relation("HostelFeeStudent", fields: [studentId], references: [id])
  semesterId   String             @db.Uuid
  hostelId     String             @db.Uuid
  hostel       Hostel             @relation(fields: [hostelId], references: [id])
  allocationId String?            @unique @db.Uuid
  bookingId    String?            @unique @db.Uuid
  description  String
  /// Cedis (pesewas). Zero once the place is given up; payments above it are shown as a refund due.
  amount       Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  payments     HostelFeePayment[]

  @@index([semesterId, hostelId])
  @@index([studentId])
}

enum HostelPaymentMethod {
  ONLINE
  CASH
  MOBILE_MONEY
  BANK
}

model HostelFeePayment {
  id             String              @id @default(uuid()) @db.Uuid
  feeId          String              @db.Uuid
  fee            HostelFee           @relation(fields: [feeId], references: [id])
  amount         Int
  method         HostelPaymentMethod
  /// Paystack reference (online) or the MoMo / bank transaction ID.
  reference      String?             @unique
  receiptNumber  String              @unique
  paidOn         DateTime            @db.Date
  recordedById   String              @db.Uuid
  createdAt      DateTime            @default(now())
  reversedAt     DateTime?
  reversedById   String?             @db.Uuid
  reversalReason String?

  @@index([feeId])
}

/// Online private-hostel fees collected by the university and paid out to the owner by Finance.
model HostelOwnerPayout {
  id           String   @id @default(uuid()) @db.Uuid
  hostelId     String   @db.Uuid
  hostel       Hostel   @relation(fields: [hostelId], references: [id])
  amount       Int
  reference    String?
  note         String?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())
}

/// A form students must complete for a hostel: tenancy agreement, registration form and so on.
/// hostelId empty means every university hall.
model HostelFormTemplate {
  id          String                 @id @default(uuid()) @db.Uuid
  title       String
  description String?
  hostelId    String?                @db.Uuid
  hostel      Hostel?                @relation(fields: [hostelId], references: [id])
  documentId  String                 @db.Uuid
  document    StoredDocument         @relation(fields: [documentId], references: [id])
  isActive    Boolean                @default(true)
  createdById String                 @db.Uuid
  createdAt   DateTime               @default(now())
  submissions HostelFormSubmission[]
}

enum FormSubmissionStatus {
  SUBMITTED
  ACCEPTED
  RETURNED
}

/// A student's signed copy of a hostel form for a semester. Uploading again replaces it.
model HostelFormSubmission {
  id           String               @id @default(uuid()) @db.Uuid
  templateId   String               @db.Uuid
  template     HostelFormTemplate   @relation(fields: [templateId], references: [id])
  studentId    String               @db.Uuid
  student      User                 @relation("HostelFormStudent", fields: [studentId], references: [id])
  semesterId   String               @db.Uuid
  documentId   String               @db.Uuid
  document     StoredDocument       @relation(fields: [documentId], references: [id])
  status       FormSubmissionStatus @default(SUBMITTED)
  note         String?
  reviewedById String?              @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([templateId, studentId, semesterId])
}

enum ComplaintCategory {
  SAFETY
  CLEANLINESS
  WATER_POWER
  OWNER_CONDUCT
  PRICING
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// A student's complaint about a private hostel, handled by the Hostel Office. The owner sees it, but
/// not who made it unless the student agrees.
model HostelComplaint {
  id            String            @id @default(uuid()) @db.Uuid
  hostelId      String            @db.Uuid
  hostel        Hostel            @relation(fields: [hostelId], references: [id])
  studentId     String            @db.Uuid
  student       User              @relation("HostelComplaintStudent", fields: [studentId], references: [id])
  category      ComplaintCategory
  description   String
  shareName     Boolean           @default(false)
  status        ComplaintStatus   @default(OPEN)
  officeNote    String?
  ownerResponse String?
  ownerRespondedAt DateTime?
  handledById   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([hostelId, status])
}
