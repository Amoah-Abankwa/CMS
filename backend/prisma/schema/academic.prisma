model School {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id         String         @id @default(uuid()) @db.Uuid
  code       String         @unique
  name       String
  schoolId   String         @db.Uuid
  school     School         @relation(fields: [schoolId], references: [id])
  isDemo     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  programmes Programme[]
  staff      StaffProfile[]
  courses    Course[]
  associations   AssociationDepartment[]
  /// Set by the Head of Department: mark students with unpaid compulsory dues on exam attendance registers. Nothing is ever blocked.
  showDuesOnRegister Boolean @default(false)
}

model Programme {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  name           String
  departmentId   String           @db.Uuid
  department     Department       @relation(fields: [departmentId], references: [id])
  levelCode      String
  level          ProgrammeLevel   @relation(fields: [levelCode], references: [code])
  durationYears  Int
  /// Overrides the programme type's number of semesters when set.
  semesters      Int?
  /// The programme's own code in index numbers, e.g. DCE, when its type's format uses {PROG}.
  indexCode      String?          @unique
  isActive       Boolean          @default(true)
  isDemo         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  students       StudentProfile[]
  curriculum     ProgrammeCourse[]
  feeSchedules   FeeSchedule[]
}

model AcademicYear {
  id        String     @id @default(uuid()) @db.Uuid
  label     String     @unique
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  isCurrent Boolean    @default(false)
  semesters Semester[]
}

model Semester {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  number         Int
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  isCurrent      Boolean      @default(false)
  /// Students can build and submit course registration only inside this window.
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  minCredits     Int          @default(12)
  maxCredits     Int          @default(24)
  /// Summer only (semester 3): what regular students may take. Weekend students register as usual.
  summerKind     SummerKind?
  /// Students may ask to drop a registered course until this moment (set by the Registrar).
  dropDeadline   DateTime?
  offerings      CourseOffering[]
  registrations  CourseRegistration[]
  examTimetable  ExamTimetable?
  clearances     FinancialClearance[]
  examHolds      ExamHold[]
  eligibilityList ExamEligibilityList?
  devotionServices DevotionService[]
  devotionResults  DevotionResult[]
  accommodationRound AccommodationRound?
  feeSchedules   FeeSchedule[]
  studentBills   StudentBill[]
  duesLevies     DuesLevy[]

  @@unique([academicYearId, number])
}

model Course {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique
  title        String
  creditHours  Int
  level        Int
  semesterNo   Int
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean    @default(true)
  isDemo       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  offerings    CourseOffering[]
  curriculum   ProgrammeCourse[]
  readingList    ReadingList?
  description    String?
  prerequisites  CoursePrerequisite[] @relation("CourseNeeds")
  requiredFor    CoursePrerequisite[] @relation("CourseRequiredFor")
  approvals      CourseApproval[]
}

enum SummerKind {
  /// Courses failed or not yet taken.
  PROMOTIONAL
  /// Any course, to improve the grade.
  UPGRADE
}

/// A course that must have been taken (any grade) before another can be registered.
model CoursePrerequisite {
  courseId       String @db.Uuid
  course         Course @relation("CourseNeeds", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteId String @db.Uuid
  prerequisite   Course @relation("CourseRequiredFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([courseId, prerequisiteId])
}

/// A course outside a student's programme, approved for that student for one term (by their advisor,
/// Head of Department or the Registry).
model CourseApproval {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  student      User     @relation("CourseApprovalStudent", fields: [studentId], references: [id])
  courseId     String   @db.Uuid
  course       Course   @relation(fields: [courseId], references: [id])
  semesterId   String   @db.Uuid
  reason       String
  approvedById String   @db.Uuid
  createdAt    DateTime @default(now())

  @@unique([studentId, courseId, semesterId])
}
